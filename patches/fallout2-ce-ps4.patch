 {
     if (ms <= 0) {
         return;
     }
+#ifdef __PS4__
+    // SDL_Delay does not return reliably on Orbis; use the libc sleep.
+    usleep((useconds_t)ms * 1000);
+#else
     SDL_Delay(ms);
+#endif
 }
